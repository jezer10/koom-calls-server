{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testTimeout": 20000,
  "setupFiles": ["<rootDir>/jest.env-setup.js"],
  "globalSetup": "<rootDir>/jest.global-setup.js"
}
