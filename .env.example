# =============================================================================
# koom-calls-server · variables de entorno (desarrollo local)
# =============================================================================
# Copiar a `.env` y editar. El servidor valida con zod al arrancar.
# En `NODE_ENV=development`, JWT_SECRET se auto-genera (con warning).
#
# En producción, usar `.env.example.docker` como referencia.
# =============================================================================

NODE_ENV=development
PORT=8080
CORS_ORIGIN=*

# Auth (en dev se autogenera; en prod debe ser fijo y seguro)
# JWT_SECRET=__REPLACE_ME__
JWT_TTL=1h

# Base de datos (en dev usa SQLite in-memory)
DATABASE_URL=sqlite::memory:

# Redis (opcional; si vacío, presencia in-memory y adapter WS desactivado)
# REDIS_URL=redis://localhost:6379

# TURN (en dev, defaults a placeholders; para pruebas reales usar uno público)
# TURN_URL=turn:turn.example.com:3478
# TURN_SHARED_SECRET=dev-turn-secret
# TURN_TTL=3600

# LiveKit (en dev, sin SFU real; el media provider cae a Noop)
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=devsecret
