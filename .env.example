# ----------------------------------------------------------------------------
# Koom Calls — server configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# See `docs/adr/0001-webrtc-multiusuario-control-plane.md` for context.
# ----------------------------------------------------------------------------

# --- HTTP / signaling --------------------------------------------------------
# Port the NestJS HTTP server binds to.
PORT=8080

# Comma-separated list of allowed CORS origins, or `*` for any.
CORS_ORIGIN=*

# Socket.IO namespace used for in-app signaling (room events, presence, etc.).
SIGNALING_NAMESPACE=/signaling

# --- Persistence -------------------------------------------------------------
# TypeORM/DB connection string. Defaults to an in-memory SQLite database,
# which is fine for local development only. Production must use a real
# database (Postgres recommended from M2).
DATABASE_URL=sqlite::memory:

# --- Auth / JWT --------------------------------------------------------------
# Secret used to sign access tokens. Required in production; if absent in
# development the server auto-generates a random secret and logs a warning.
JWT_SECRET=replace-me-in-production
JWT_TTL=1h

# --- LiveKit (SFU, M2+) ------------------------------------------------------
# Optional in M1. When provided, the server can mint LiveKit access tokens
# for the SPA. Leave empty to disable the integration.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Redis (presence, pub/sub, cache) ---------------------------------------
# Optional in M1. When set, the server uses Redis for cross-instance pub/sub
# and ephemeral credential cache. Leave empty for a single-process dev setup.
REDIS_URL=

# --- TURN / STUN (NAT traversal) ---------------------------------------------
# coturn endpoint used to issue short-lived TURN credentials. The shared
# secret is used together with `TURN_TTL` to sign time-limited usernames
# (RFC 7635 / coturn `use-auth-secret`). Leave empty in M1.
TURN_URL=
TURN_SHARED_SECRET=
TURN_TTL=3600

# --- Legacy PeerJS broker (deprecated, will be removed in M2-M4) -------------
# Kept for backwards compatibility with M0 deployments. The default `false`
# disables the broker; existing installations may temporarily set this to
# `true` while they migrate. See ADR 0001.
PEER_ENABLED=false
PEER_PORT=9000
PEER_KEY=peerjs
PEER_PATH=/
PEER_ALLOW_DISCOVERY=false

# --- Runtime -----------------------------------------------------------------
# Standard Node.js mode. Use `development`, `test` or `production`.
NODE_ENV=development
