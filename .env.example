# =============================================================================
# koom-calls-server · variables base
# =============================================================================
# Copiar a `.env` y ajustar según el flujo que vayas a usar.
#
# - Desarrollo local:
#   - `docker compose -f docker-compose.dev.yml up -d`
#   - `pnpm run start:dev`
# - Stack Docker completo:
#   - `docker compose up -d --build`
#
# Postgres es obligatorio.
# Redis es opcional: si no está disponible, la app degrada presencia + adapter
# WS a memoria local.
# =============================================================================

NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
SIGNALING_NAMESPACE=/signaling

# Base de datos
POSTGRES_USER=koom
POSTGRES_PASSWORD=koom-dev-password
POSTGRES_DB=koom
DATABASE_URL=postgres://koom:koom-dev-password@localhost:5432/koom
# DATABASE_SSL=false

# Auth
JWT_SECRET=dev-jwt-secret-change-me
JWT_TTL=1h
# JWT_AUDIENCE=koom-api
# JWT_ISSUER=http://localhost:8080

# Google OAuth
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=__REPLACE_ME__
# GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# Redis
REDIS_URL=redis://localhost:6379

# TURN
TURN_URL=turn:localhost:3478
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
TURN_SHARED_SECRET=dev-turn-secret
TURN_TTL=3600
TURN_REALM=koom.local
TURN_STUN_URLS=stun:stun.l.google.com:19302

# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HTTP_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
SFU_URL=ws://localhost:7880

# Ajustes finos
# PRESENCE_TTL_SECONDS=60
# RATE_LIMIT_SOCKET_PER_SECOND=20
# RATE_LIMIT_USER_PER_SECOND=10
# RATE_LIMIT_IP_PER_SECOND=30
# RATE_LIMIT_SOCKET_BURST=5
# RATE_LIMIT_USER_BURST=3
# RATE_LIMIT_IP_BURST=8
# SFU_TOKEN_TTL_SECONDS=3600
# TURN_TOKEN_TTL_SECONDS=3600
# LOG_LEVEL=debug
