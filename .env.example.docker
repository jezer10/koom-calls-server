# Sample environment file consumed by `docker compose` for local development.
# Copy to `.env` next to `docker-compose.yml` (`back/.env`) and tweak as needed.
# This file is separate from `.env.example` (the non-Docker dev env) because the
# hostnames below (postgres, redis, livekit, coturn) only resolve inside the
# compose network.

# ---------- PostgreSQL ----------
POSTGRES_USER=koom
POSTGRES_PASSWORD=koom-dev-password
POSTGRES_DB=koom

# ---------- Redis ----------
REDIS_URL=redis://redis:6379

# ---------- API ----------
# Hostname `postgres` and `redis` are the compose service names.
DATABASE_URL=postgres://koom:koom-dev-password@postgres:5432/koom
JWT_SECRET=dev-secret-change-me
PORT=8080
SIGNALING_NAMESPACE=/signaling
CORS_ORIGIN=*
# PeerJS is optional in compose; disable it to keep ports clean.
SKIP_PEER=1

# ---------- LiveKit ----------
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-please-change

# ---------- TURN (coturn) ----------
TURN_URL=turn:coturn:3478
TURN_SHARED_SECRET=dev-turn-secret
TURN_TTL=3600
