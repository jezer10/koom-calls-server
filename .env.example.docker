# =============================================================================
# koom-calls-server · stack Docker local / servidor simple
# =============================================================================

NODE_ENV=production
PORT=8080
CORS_ORIGIN=https://app.example.com
SIGNALING_NAMESPACE=/signaling

# Base de datos (obligatoria)
POSTGRES_USER=koom
POSTGRES_PASSWORD=__REPLACE_ME__
POSTGRES_DB=koom
DATABASE_URL=postgres://koom:__REPLACE_ME__@postgres:5432/koom
# DATABASE_SSL=true

# Auth
JWT_SECRET=__REPLACE_ME__
JWT_TTL=1h
# JWT_AUDIENCE=koom-api
# JWT_ISSUER=https://api.example.com

# Google OAuth
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=__REPLACE_ME__
GOOGLE_REDIRECT_URI=https://api.example.com/auth/google/callback
FRONTEND_ORIGIN=https://app.example.com

# Redis (opcional)
REDIS_URL=redis://redis:6379

# TURN
TURN_URL=turn:turn.example.com:3478
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_SHARED_SECRET=__REPLACE_ME__
TURN_TTL=3600
TURN_REALM=koom.local
TURN_STUN_URLS=stun:stun.l.google.com:19302

# LiveKit
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_HTTP_URL=http://livekit:7880
LIVEKIT_API_KEY=__REPLACE_ME__
LIVEKIT_API_SECRET=__REPLACE_ME__
SFU_URL=wss://livekit.example.com

# Ajustes finos
# PRESENCE_TTL_SECONDS=60
# RATE_LIMIT_SOCKET_PER_SECOND=20
# RATE_LIMIT_USER_PER_SECOND=10
# RATE_LIMIT_IP_PER_SECOND=30
# RATE_LIMIT_SOCKET_BURST=5
# RATE_LIMIT_USER_BURST=3
# RATE_LIMIT_IP_BURST=8
# SFU_TOKEN_TTL_SECONDS=3600
# TURN_TOKEN_TTL_SECONDS=3600
# LOG_LEVEL=info
