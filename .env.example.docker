# =============================================================================
# koom-calls-server · variables de entorno (producción / staging)
# =============================================================================
# Copiar a `.env` en la VPS (ej. `~/koom-calls-server/.env`) y rellenar.
# El servidor valida este archivo con zod al arrancar y falla con mensaje
# claro si falta algo crítico en producción.
#
# Convenciones:
#   - NO commitear `.env` (está en .gitignore).
#   - Generar secretos con: openssl rand -base64 48
#   - Tras editar: `docker restart koom-calls-server` (o redeploy).
# =============================================================================

NODE_ENV=production
PORT=8080

# CORS — el origen del front. NO usar "*" si hay credenciales.
# Ejemplos:
#   CORS_ORIGIN=https://app.example.com
#   CORS_ORIGIN=https://app.example.com,https://staging.example.com
CORS_ORIGIN=https://app.example.com

# -----------------------------------------------------------------------------
# Auth (JWT) — REQUERIDO en producción
# -----------------------------------------------------------------------------
# Generar con: openssl rand -base64 48
JWT_SECRET=__REPLACE_ME__
JWT_TTL=1h
# Opcionales (recomendado en multi-tenant):
# JWT_AUDIENCE=koom-api
# JWT_ISSUER=https://api.example.com

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
# Dev / test:  DATABASE_URL=sqlite::memory:
# Prod:        DATABASE_URL=postgres://koom:<password>@postgres:5432/koom
DATABASE_URL=postgres://koom:__REPLACE_ME__@postgres:5432/koom
# El postgres del docker-compose.yml es self-hosted y no tiene TLS habilitado.
# Activar solo si el DATABASE_URL apunta a un proveedor que exige SSL (ej. RDS).
# DATABASE_SSL=true

# -----------------------------------------------------------------------------
# Redis (presencia + adapter Socket.IO para escalar horizontal)
# -----------------------------------------------------------------------------
# Si está vacío, el adapter WS se desactiva y la presencia usa in-memory.
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# TURN (coturn) — REQUERIDO en producción
# -----------------------------------------------------------------------------
# URL pública del TURN (la misma que usa el cliente).
TURN_URL=turn:turn.example.com:3478
# Secret compartido con coturn (use-auth-secret en turnserver.conf).
TURN_SHARED_SECRET=__REPLACE_ME__
# TTL de credenciales TURN (segundos). Default 3600.
TURN_TTL=3600
# Realm de coturn. Default koom.local.
TURN_REALM=koom.local
# STUN servers extra (CSV). Default stun:stun.l.google.com:19302
# TURN_STUN_URLS=stun:a.example.com:3478,stun:b.example.com:3478

# -----------------------------------------------------------------------------
# LiveKit (SFU) — REQUERIDO para llamadas multiusuario reales
# -----------------------------------------------------------------------------
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=__REPLACE_ME__
LIVEKIT_API_SECRET=__REPLACE_ME__

# -----------------------------------------------------------------------------
# Opcionales (rate limiting, presence TTL, signalización)
# -----------------------------------------------------------------------------
# SIGNALING_NAMESPACE=/signaling
# PRESENCE_TTL_SECONDS=60
# RATE_LIMIT_SOCKET_BURST=30
# RATE_LIMIT_SOCKET_PER_SECOND=30
# RATE_LIMIT_USER_BURST=100
# RATE_LIMIT_USER_PER_SECOND=100
# RATE_LIMIT_IP_BURST=200
# RATE_LIMIT_IP_PER_SECOND=200
# SFU_TOKEN_TTL_SECONDS=3600
# TURN_TOKEN_TTL_SECONDS=3600
# LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Google OAuth (Authorization Code flow, popup, con postMessage) — REQUERIDO en producción
# -----------------------------------------------------------------------------
# OAuth Client tipo "Web application" en Google Cloud Console.
# Authorized JavaScript origins debe incluir EXACTAMENTE el origin del front
# (incluyendo esquema). NO usar localhost en producción.
# Authorized redirect URIs debe incluir EXACTAMENTE el valor de GOOGLE_REDIRECT_URI.
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=__REPLACE_ME__
# GOOGLE_REDIRECT_URI=https://api.example.com/auth/google/callback
# Front-end origin (para postMessage origin validation y redirect de vuelta).
# FRONTEND_ORIGIN=https://app.example.com
